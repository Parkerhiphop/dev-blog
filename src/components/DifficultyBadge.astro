---
interface Props {
  difficulty: 'Easy' | 'Medium' | 'Hard';
}

const { difficulty } = Astro.props;
const colorClass = {
  Easy: 'border-emerald-500/50 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  Medium: 'border-amber-500/50 bg-amber-500/10 text-amber-700 dark:text-amber-300',
  Hard: 'border-rose-500/50 bg-rose-500/10 text-rose-700 dark:text-rose-300',
}[difficulty];
---
<span class:list={['inline-flex rounded border px-1.5 py-0.5 font-medium', colorClass]}>{difficulty}</span>
