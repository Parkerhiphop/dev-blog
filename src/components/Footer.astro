---
interface Props {
  lang: 'zh' | 'en' | 'ja';
}
const { lang } = Astro.props;
const t = lang === 'en'
  ? { life: 'Life blog', github: 'GitHub' }
  : lang === 'ja'
    ? { life: 'ライフブログ', github: 'GitHub' }
    : { life: '生活部落格', github: 'GitHub' };
---
<footer class="border-t border-[var(--color-border)] px-4 py-6 text-xs opacity-80">
  <p>
    © {new Date().getFullYear()} Parker Chang ·
    <a href="https://www.parkerchang.life" class="text-accent">{t.life}</a> ·
    <a href="https://github.com/Parkerhiphop" class="text-accent">{t.github}</a>
  </p>
</footer>
