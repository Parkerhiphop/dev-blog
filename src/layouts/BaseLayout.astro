---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'zh' | 'en' | 'ja';
  wide?: boolean;
  ogImage?: string;
}
const { title, description, lang, wide = false, ogImage } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta property="og:title" content={`${title} · Parker's Dev Blog`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />}
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Parker's Dev Blog</title>
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
    <script is:inline>
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('.rss-copy');
        if (!button) return;
        const url = new URL(button.dataset.rssUrl, window.location.origin).href;
        const originalLabel = button.getAttribute('aria-label');
        const originalContent = button.innerHTML;
        try {
          await navigator.clipboard.writeText(url);
          button.setAttribute('aria-label', button.dataset.copiedLabel);
          button.textContent = '✓';
          window.setTimeout(() => {
            button.setAttribute('aria-label', originalLabel);
            button.innerHTML = originalContent;
          }, 1800);
        } catch {
          window.prompt('Copy RSS URL:', url);
        }
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav lang={lang} />
    <main class:list={['mx-auto w-full flex-1 px-4 py-8', wide ? 'max-w-6xl' : 'max-w-3xl']}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
