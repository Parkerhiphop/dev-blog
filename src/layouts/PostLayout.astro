---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Utterances from '../components/Utterances.astro';
import { getReadingTimeMinutes, getLangFromId } from '../lib/post-utils';
import type { Post } from '../lib/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  post: Post;
  headings: Heading[];
}
const { post, headings } = Astro.props;
const lang = getLangFromId(post.id);
const minutes = getReadingTimeMinutes(post.body ?? '', lang);
const hasTableOfContents = headings.some(({ depth }) => depth === 2 || depth === 3);
---
<BaseLayout title={post.data.title} description={post.data.description} lang={lang} wide={hasTableOfContents}>
  <div class:list={['grid items-start gap-6', hasTableOfContents && 'lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-10']}>
    <TableOfContents headings={headings} />
    <article class="post-content prose prose-slate min-w-0 max-w-none dark:prose-invert lg:order-first">
      <h1 class="font-pixel text-xl leading-relaxed text-accent">{post.data.title}</h1>
      <p class="text-sm opacity-70">
        {post.data.pubDate.toISOString().slice(0, 10)} · {minutes} min
      </p>
      <slot />
    </article>
  </div>
  <Utterances />
</BaseLayout>

<style>
  .post-content {
    overflow-wrap: anywhere;
  }

  .post-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    overflow-wrap: normal;
  }

  .post-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
